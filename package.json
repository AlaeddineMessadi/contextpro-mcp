{
  "name": "contextpro-mcp",
  "version": "1.3.0",
  "description": "Private standalone MCP code intelligence engine for low-token, project-scoped coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlaeddineMessadi/contextpro-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AlaeddineMessadi/contextpro-mcp/issues"
  },
  "homepage": "https://github.com/AlaeddineMessadi/contextpro-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-intelligence",
    "coding-agent",
    "semantic-search",
    "scip",
    "lsp",
    "rag"
  ],
  "engines": {
    "node": ">=20 <27"
  },
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "STATUS.md",
    "AUDIT.md",
    "LICENSE",
    "INSTRUCTIONS.md",
    "agent-instructions.md",
    "docs/roadmaps"
  ],
  "bin": {
    "contextpro-mcp": "./build/index.js",
    "contextpro": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "pretest": "npm run build",
    "test": "node --test test/main/*.test.mjs",
    "test:demo": "node --test test/demo/*.demo.mjs",
    "test:all": "node --test test/main/*.test.mjs test/demo/*.demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "ignore": "^7.0.4",
    "ml-matrix": "^6.12.1",
    "ollama": "^0.6.3",
    "p-limit": "^7.3.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tailwindcss": "^4.2.1"
  }
}
