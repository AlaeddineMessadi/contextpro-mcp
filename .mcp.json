{
  "mcpServers": {
    "contextplus": {
      "command": "node",
      "args": ["/path/to/contextplus-official/build/index.js"],
      "env": {
        "CONTEXTPLUS_EMBED_PROVIDER": "ollama",
        "OLLAMA_EMBED_MODEL": "nomic-embed-text",
        "OLLAMA_CHAT_MODEL": "minimax-m2.7:cloud",
        "CONTEXTPLUS_EMBED_TRACKER": "lazy"
      }
    }
  }
}
